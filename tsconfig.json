{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "types": ["vite/client"], "erasableSyntaxOnly": true, "verbatimModuleSyntax": true, "resolveJsonModule": true
  },
  "include": ["src", "talk"]
}
